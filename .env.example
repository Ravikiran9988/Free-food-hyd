# Free Food Hyderabad environment template
# Copy this file to .env and replace all placeholder secrets before use.

# Database

# no need in production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=freefoodhyd
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 1. APPLICATION DATABASE (FastAPI Backend + Storage)
# - Local Docker / VPS: postgresql://postgres:postgres@db:5432/freefoodhyd
# - Cloud Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@db:5432/freefoodhyd

# Authentication / security
# JWT signing/verification secret. Use a long random value in production.
ADMIN_SECRET_KEY=change_this_to_a_secure_random_string_in_production
# Comma-separated allowed browser origins. Restrict this in production.
CORS_ORIGINS=*
# Bootstrap credentials used only by apps/backend/seed.py. Never commit real credentials.
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# 2. DATA PIPELINE / UPSTREAM SOURCE SUPABASE (Read-only Scraper Source)
# Used by data-pipeline/src/scraper.py to read the external Annadhanam Spots location_feed table.
# This is completely separate from your application DATABASE_URL above.
SOURCE_SUPABASE_URL=https://upstream-source.supabase.co/rest/v1
SOURCE_SUPABASE_KEY=upstream_publishable_anon_key
SYNC_SCHEDULE_HOUR=2

# Optional secret to trigger scheduled sync via HTTP (for GitHub Actions or cron-job.org)
CRON_SECRET=change_this_to_a_random_cron_secret

